---
import { site } from "../data/site";
import { heroStack } from "../data/skills";
import { withBase } from "../lib/url";

const facts = [
  { value: "5+", label: "Person delivery teams" },
  { value: "Gov", label: "Institution systems shipped" },
  { value: "QGIS", label: "Geospatial platform" },
  { value: "LLMs", label: "Evaluated head to head" },
];
---

<section class="relative overflow-hidden border-b border-line">
  {/* Backdrop: hairline grid fading out, plus one warm bloom behind the type. */}
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="bg-grid mask-fade-b absolute inset-0 opacity-[0.55]"></div>
    <div
      class="absolute left-1/2 top-0 h-[420px] w-[820px] max-w-full -translate-x-1/2 -translate-y-1/3 rounded-full opacity-70 blur-3xl"
      style="background: radial-gradient(circle, rgba(230,180,80,0.10) 0%, transparent 70%)"
    >
    </div>
  </div>

  <div class="relative mx-auto max-w-5xl px-6 pb-20 pt-36 sm:pb-28 sm:pt-44">
    <div data-reveal class="flex items-center gap-3">
      <span class="label label-accent">{site.role}</span>
      <span class="h-px w-8 bg-accent/40" aria-hidden="true"></span>
      <span class="label">{site.location}</span>
    </div>

    <h1
      data-reveal
      style="--reveal-delay: 80ms"
      class="mt-6 text-5xl font-semibold sm:text-6xl lg:text-7xl"
    >
      {site.name}
    </h1>

    <p
      data-reveal
      style="--reveal-delay: 160ms"
      class="prose-body mt-7 max-w-2xl text-lg sm:text-xl"
    >
      I build software systems <strong>end to end</strong> — application logic and
      backend architecture through to the interfaces, integrations and automation
      that surround them. The rest of my time goes to taking language models apart
      to understand <strong>how they actually reason</strong>.
    </p>

    <div
      data-reveal
      style="--reveal-delay: 240ms"
      class="mt-9 flex flex-wrap items-center gap-3"
    >
      <a href={withBase("/projects")} class="btn btn-primary">
        View selected work
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0-5-5m5 5-5 5" />
        </svg>
      </a>
      <a href={withBase("/about")} class="btn btn-ghost">Read the long version</a>
      {
        site.resumeUrl && (
          <a href={withBase(site.resumeUrl)} class="btn btn-ghost">
            Résumé (PDF)
          </a>
        )
      }
    </div>

    <div
      data-reveal
      style="--reveal-delay: 320ms"
      class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-4"
    >
      {
        facts.map((fact) => (
          <div class="bg-bg-raised px-5 py-5">
            <p class="font-mono text-xl font-medium text-accent">{fact.value}</p>
            <p class="mt-1.5 text-xs leading-snug text-fg-subtle">{fact.label}</p>
          </div>
        ))
      }
    </div>

    <div
      data-reveal
      style="--reveal-delay: 400ms"
      class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2"
    >
      <span class="label">Stack</span>
      {
        heroStack.map((tech) => (
          <span class="font-mono text-xs text-fg-subtle">{tech}</span>
        ))
      }
    </div>
  </div>
</section>
