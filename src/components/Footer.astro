---
import { site } from "../data/site";
import { withBase } from "../lib/url";
import Social from "./Social.astro";

const year = new Date().getFullYear();

const columns = [
  {
    title: "Pages",
    links: [
      { label: "Home", href: withBase("/") },
      { label: "Projects", href: withBase("/projects") },
      { label: "About", href: withBase("/about") },
    ],
  },
  {
    title: "Elsewhere",
    links: [
      { label: "GitHub", href: site.socials.github, external: true },
      { label: "LinkedIn", href: site.socials.linkedin, external: true },
      { label: "Email", href: `mailto:${site.email}` },
    ],
  },
];
---

<footer class="border-t border-line">
  <div class="mx-auto max-w-5xl px-6 py-14">
    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4">
      <div class="md:col-span-2">
        <p class="label mb-3">{site.role}</p>
        <p class="max-w-xs text-sm leading-relaxed text-fg-muted">
          Building systems end to end — and spending the rest of the time
          working out how models actually reason.
        </p>
        <div class="mt-5 flex items-center gap-3">
          <Social href={site.socials.github} name="github" label="GitHub" />
          <Social href={site.socials.linkedin} name="linkedin" label="LinkedIn" />
          <Social href={`mailto:${site.email}`} name="mail" label="Email" />
        </div>
      </div>

      {
        columns.map((col) => (
          <div>
            <p class="label mb-3">{col.title}</p>
            <ul class="space-y-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={"external" in link && link.external ? "_blank" : undefined}
                    rel={"external" in link && link.external ? "noopener noreferrer" : undefined}
                    class="text-sm text-fg-muted transition-colors hover:text-accent"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="font-mono text-xs text-fg-subtle">
        © {year} {site.name}
      </p>
      <p class="font-mono text-xs text-fg-subtle">
        Astro · Tailwind CSS · deployed on GitHub Pages
      </p>
    </div>
  </div>
</footer>
