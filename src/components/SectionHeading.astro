---
interface Props {
  /** Two-digit section marker, e.g. "02". */
  index?: string;
  eyebrow: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
}

const { index, eyebrow, title, lead, align = "left" } = Astro.props;
---

<div
  data-reveal
  class:list={[
    "max-w-2xl",
    align === "center" && "mx-auto text-center",
  ]}
>
  <div
    class:list={[
      "flex items-center gap-3",
      align === "center" && "justify-center",
    ]}
  >
    {index && <span class="label label-accent">{index}</span>}
    <span class="h-px w-6 bg-line-strong" aria-hidden="true"></span>
    <span class="label">{eyebrow}</span>
  </div>

  <h2 class="mt-5 text-3xl font-semibold sm:text-4xl">{title}</h2>

  {lead && <p class="prose-body mt-4">{lead}</p>}
</div>
