---
import { focusAreas } from "../data/ai";
---

<div class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
  {
    focusAreas.map((area, i) => (
      <div
        data-reveal
        style={`--reveal-delay: ${i * 70}ms`}
        class="group bg-bg-raised p-6 transition-colors duration-300 hover:bg-bg-hover sm:p-7"
      >
        <div class="flex items-baseline gap-3">
          <span class="font-mono text-xs text-accent">{area.index}</span>
          <h3 class="text-base font-semibold">{area.title}</h3>
        </div>

        <p class="mt-3 text-sm leading-relaxed text-fg-muted">{area.body}</p>

        <div class="mt-5 flex flex-wrap gap-1.5">
          {area.keywords.map((kw) => (
            <span class="tag">{kw}</span>
          ))}
        </div>
      </div>
    ))
  }
</div>
