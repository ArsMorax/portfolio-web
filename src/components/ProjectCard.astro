---
import type { Project } from "../data/projects";
import { categoryLabels } from "../data/projects";
import { withBase } from "../lib/url";

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const href = withBase(`/projects/${project.id}`);
const marker = String(index + 1).padStart(2, "0");
---

<article
  data-reveal
  style={`--reveal-delay: ${index * 70}ms`}
  class="group panel panel-interactive relative flex flex-col overflow-hidden hover:-translate-y-1"
>
  <div class="relative h-44 shrink-0 overflow-hidden border-b border-line bg-bg-sunken">
    {
      project.image ? (
        <img
          src={withBase(project.image)}
          alt=""
          loading="lazy"
          decoding="async"
          class="h-full w-full scale-105 object-cover opacity-40 grayscale transition-all duration-700 ease-out group-hover:scale-100 group-hover:opacity-70 group-hover:grayscale-0"
        />
      ) : (
        <div class="bg-grid absolute inset-0 opacity-40" />
      )
    }

    <div class="absolute inset-0 bg-gradient-to-t from-bg-raised via-bg-raised/40 to-transparent"></div>

    {/* Top scrim: the index numeral sits over the image, and several of the
        screenshots are light enough to swallow it without this. */}
    <div class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-bg-raised/85 to-transparent"></div>

    <span
      class="absolute left-5 top-4 font-mono text-4xl font-medium text-line-strong transition-colors duration-500 group-hover:text-accent/35"
      aria-hidden="true"
    >
      {marker}
    </span>

    <div class="absolute bottom-4 left-5 right-5 flex items-end justify-between gap-3">
      <span class="label">{categoryLabels[project.category]}</span>
      <span class="label">{project.year}</span>
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="text-lg font-semibold tracking-tight">
      {/* Stretched link: keeps one accessible link while leaving room for the
          repo/live buttons below to stay independently clickable. */}
      <a href={href} class="transition-colors duration-200 before:absolute before:inset-0 before:content-[''] group-hover:text-accent">
        {project.title}
      </a>
    </h3>

    <p class="mt-1 text-sm text-fg-subtle">{project.subtitle}</p>

    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-fg-muted">
      {project.summary}
    </p>

    <div class="mt-4 flex flex-wrap gap-1.5">
      {project.stack.slice(0, 4).map((tech) => <span class="tag">{tech}</span>)}
      {
        project.stack.length > 4 && (
          <span class="tag text-fg-subtle">+{project.stack.length - 4}</span>
        )
      }
    </div>

    <div class="mt-auto"></div>

    <div class="mt-5 flex items-center justify-between gap-3 border-t border-line pt-4">
      <span class="label">{project.context}</span>
      <span
        class="inline-flex items-center gap-1.5 text-xs font-medium text-fg-muted transition-colors duration-200 group-hover:text-accent"
      >
        Case study
        <svg
          class="h-3 w-3 transition-transform duration-300 group-hover:translate-x-0.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0-5-5m5 5-5 5" />
        </svg>
      </span>
    </div>
  </div>
</article>
