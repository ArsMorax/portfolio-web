---
import { roles } from "../data/experience";
---

<ol class="relative space-y-12 border-l border-line pl-8 sm:pl-10">
  {
    roles.map((role, i) => (
      <li data-reveal style={`--reveal-delay: ${i * 90}ms`} class="relative">
        {/* Marker sits on the rail. Professional roles get the accent. */}
        <span
          class:list={[
            "absolute -left-[2.3125rem] top-1.5 h-2.5 w-2.5 rounded-full border-2 sm:-left-[2.8125rem]",
            role.kind === "Professional"
              ? "border-accent bg-bg"
              : "border-line-strong bg-bg",
          ]}
          aria-hidden="true"
        />

        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <h3 class="text-xl font-semibold">{role.title}</h3>
          {role.organization && (
            <span class="text-sm text-fg-muted">{role.organization}</span>
          )}
        </div>

        <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1">
          <span class="label">{role.kind}</span>
          {role.period && (
            <>
              <span class="h-px w-4 bg-line-strong" aria-hidden="true" />
              <span class="label">{role.period}</span>
            </>
          )}
        </div>

        <p class="prose-body mt-4 max-w-2xl text-base">{role.summary}</p>

        {role.engagements && (
          <div class="mt-6 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2">
            {role.engagements.map((eng) => (
              <div class="bg-bg-raised p-5">
                <p class="text-sm font-medium">{eng.name}</p>
                <p class="mt-2 text-sm leading-relaxed text-fg-muted">
                  {eng.detail}
                </p>
              </div>
            ))}
          </div>
        )}

        <ul class="mt-6 space-y-2.5">
          {role.highlights.map((item) => (
            <li class="flex gap-3 text-sm leading-relaxed text-fg-muted">
              <span class="mt-2 h-px w-3 shrink-0 bg-accent/60" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="mt-6 flex flex-wrap gap-1.5">
          {role.stack.map((tech) => (
            <span class="tag">{tech}</span>
          ))}
        </div>
      </li>
    ))
  }
</ol>
