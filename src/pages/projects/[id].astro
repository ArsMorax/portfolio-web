---
import Layout from "../../layouts/Layout.astro";
import ContactCTA from "../../components/ContactCTA.astro";
import { projects, categoryLabels } from "../../data/projects";
import type { Project } from "../../data/projects";
import { withBase } from "../../lib/url";

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      prev: projects[(index - 1 + projects.length) % projects.length]!,
      next: projects[(index + 1) % projects.length]!,
    },
  }));
}

interface Props {
  project: Project;
  prev: Project;
  next: Project;
}

const { project, prev, next } = Astro.props;

const meta = [
  { label: "Year", value: project.year },
  { label: "Type", value: categoryLabels[project.category] },
  { label: "Context", value: project.context },
  ...(project.role ? [{ label: "Role", value: project.role }] : []),
  ...(project.team ? [{ label: "Team", value: project.team }] : []),
];
---

<Layout title={project.title} description={project.summary} type="article">
  <article>
    {/* ── Header ─────────────────────────────────────────────── */}
    <header class="relative overflow-hidden border-b border-line">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="bg-grid mask-fade-b absolute inset-0 opacity-40"></div>
      </div>

      <div class="relative mx-auto max-w-4xl px-6 pb-14 pt-32 sm:pt-40">
        <a
          href={withBase("/projects")}
          class="label inline-flex items-center gap-2 transition-colors hover:text-accent"
        >
          <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5m0 0 5 5m-5-5 5-5" />
          </svg>
          All projects
        </a>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <span class="label label-accent">{categoryLabels[project.category]}</span>
          <span class="h-px w-6 bg-line-strong" aria-hidden="true"></span>
          <span class="label">{project.year}</span>
          <span class="h-px w-6 bg-line-strong" aria-hidden="true"></span>
          <span class="label">{project.context}</span>
        </div>

        <h1 class="mt-5 text-4xl font-semibold sm:text-5xl">{project.title}</h1>
        <p class="mt-3 text-lg text-fg-muted">{project.subtitle}</p>

        {
          (project.repoUrl || project.liveUrl) && (
            <div class="mt-8 flex flex-wrap gap-3">
              {project.liveUrl && (
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary"
                >
                  View live
                </a>
              )}
              {project.repoUrl && (
                <a
                  href={project.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-ghost"
                >
                  Source code
                </a>
              )}
            </div>
          )
        }
      </div>
    </header>

    {/* ── Metrics ────────────────────────────────────────────── */}
    <section class="border-b border-line">
      <div class="mx-auto max-w-4xl px-6">
        <div class="grid grid-cols-3 gap-px bg-line">
          {
            project.metrics.map((metric) => (
              <div class="bg-bg px-2 py-6 text-center sm:py-7">
                <p class="font-mono text-lg font-medium text-accent sm:text-xl">
                  {metric.value}
                </p>
                <p class="label mt-1.5">{metric.label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    {/* ── Body ───────────────────────────────────────────────── */}
    <div class="mx-auto max-w-4xl px-6 py-16 sm:py-20">
      <div class="grid gap-14 lg:grid-cols-[1fr_15rem] lg:gap-12">
        <div class="min-w-0 space-y-14">
          <section data-reveal>
            <h2 class="label mb-5">Overview</h2>
            <div class="space-y-5">
              {project.overview.map((para) => <p class="prose-body">{para}</p>)}
            </div>
          </section>

          <section data-reveal>
            <h2 class="label mb-5">What it does</h2>
            <ul class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
              {
                project.features.map((feature) => (
                  <li class="flex gap-3 bg-bg-raised p-4">
                    <svg
                      class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                    </svg>
                    <span class="text-sm leading-relaxed text-fg-muted">{feature}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          {
            project.challenges && (
              <section data-reveal>
                <h2 class="label mb-5">What was hard</h2>
                <div class="space-y-4">
                  {project.challenges.map((challenge) => (
                    <div class="panel p-6">
                      <p class="text-sm leading-relaxed text-fg">
                        {challenge.problem}
                      </p>
                      <div class="mt-4 border-l-2 border-accent/50 pl-4">
                        <p class="label mb-1.5">How I handled it</p>
                        <p class="text-sm leading-relaxed text-fg-muted">
                          {challenge.approach}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            )
          }
        </div>

        {/* ── Sidebar ──────────────────────────────────────────── */}
        <aside class="lg:sticky lg:top-28 lg:h-fit">
          <div data-reveal class="space-y-8">
            <div>
              <h2 class="label mb-4">Details</h2>
              <dl class="space-y-4">
                {
                  meta.map((row) => (
                    <div>
                      <dt class="text-xs text-fg-subtle">{row.label}</dt>
                      <dd class="mt-0.5 text-sm leading-snug text-fg-muted">
                        {row.value}
                      </dd>
                    </div>
                  ))
                }
              </dl>
            </div>

            <div>
              <h2 class="label mb-4">Stack</h2>
              <div class="flex flex-wrap gap-1.5">
                {project.stack.map((tech) => <span class="tag">{tech}</span>)}
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>

    {/* ── Prev / next ────────────────────────────────────────── */}
    <nav class="border-t border-line" aria-label="Project navigation">
      <div class="mx-auto grid max-w-4xl gap-px bg-line sm:grid-cols-2">
        <a
          href={withBase(`/projects/${prev.id}`)}
          class="group bg-bg p-7 transition-colors hover:bg-bg-raised"
        >
          <span class="label">← Previous</span>
          <p class="mt-2 text-base font-medium transition-colors group-hover:text-accent">
            {prev.title}
          </p>
        </a>
        <a
          href={withBase(`/projects/${next.id}`)}
          class="group bg-bg p-7 text-right transition-colors hover:bg-bg-raised"
        >
          <span class="label">Next →</span>
          <p class="mt-2 text-base font-medium transition-colors group-hover:text-accent">
            {next.title}
          </p>
        </a>
      </div>
    </nav>
  </article>

  <ContactCTA />
</Layout>
