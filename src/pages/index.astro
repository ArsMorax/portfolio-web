---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import AIFocus from "../components/AIFocus.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { featuredProjects } from "../data/projects";
import { site } from "../data/site";
import { withBase } from "../lib/url";

const capabilities = [
  {
    index: "01",
    title: "Systems, end to end",
    body: "I like working holistically across a system rather than owning one slice of it — designing the application logic and backend architecture, then building the interfaces, integrations and automation workflows on top.",
  },
  {
    index: "02",
    title: "Delivery in teams",
    body: "Multiple large-scale projects built with teams of five or more, including software systems delivered for government institutions, plus a recent geospatial platform built around QGIS.",
  },
  {
    index: "03",
    title: "Deliberate range",
    body: "Every side project uses a stack I have not had the chance to use professionally yet. That is the point of them — C#, Node, React, Python and Go all arrived that way.",
  },
];
---

<Layout
  fullTitle={`${site.shortName} — ${site.role}`}
  title={site.role}
  description={site.tagline}
>
  <Hero />

  {/* ── Capabilities ─────────────────────────────────────────── */}
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <SectionHeading
        index="01"
        eyebrow="Approach"
        title="How I work"
        lead="I am a software engineer with intermediate experience, most comfortable when I can see a system all the way through rather than only the layer I was assigned."
      />

      <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-3">
        {
          capabilities.map((item, i) => (
            <div
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
              class="bg-bg-raised p-6 sm:p-7"
            >
              <span class="font-mono text-xs text-accent">{item.index}</span>
              <h3 class="mt-3 text-base font-semibold">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-fg-muted">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Selected work ────────────────────────────────────────── */}
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <SectionHeading
          index="02"
          eyebrow="Selected work"
          title="Projects worth reading about"
          lead="A professional delivery, the largest thing I have built alone, and the research habit that takes up most of my own time."
        />

        <a
          data-reveal
          href={withBase("/projects")}
          class="link-underline mt-1 shrink-0 text-sm font-medium"
        >
          All projects →
        </a>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featuredProjects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>
    </div>
  </section>

  {/* ── AI ───────────────────────────────────────────────────── */}
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-6 py-20 sm:py-24">
      <div class="flex flex-wrap items-start justify-between gap-6">
        <SectionHeading
          index="03"
          eyebrow="AI"
          title="Understanding how models think"
          lead="A significant chunk of my fascination with AI comes down to comprehending its behaviour more deeply than just its function — what a model does when the problem gets genuinely hard."
        />

        <a
          data-reveal
          href={withBase("/about#ai")}
          class="link-underline mt-1 shrink-0 text-sm font-medium"
        >
          The full picture →
        </a>
      </div>

      <div class="mt-12">
        <AIFocus />
      </div>
    </div>
  </section>

  <ContactCTA />
</Layout>
